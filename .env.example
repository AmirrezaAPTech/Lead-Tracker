# ---------- Supabase ----------
# Dashboard -> Project Settings -> API Keys.
#
# These are the HTTP API credentials, NOT a database connection string. This app
# never opens a Postgres socket, so a "postgresql://..." URI does not belong here.
#
#   SUPABASE_URL              the Project URL, e.g. https://abcdefgh.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY one of the "Secret keys" ("sb_secret_..."). Older
#                             projects show this as "service_role" ("eyJ...").
#                             NOT the Publishable key - that one has no access.
#                             If several secret keys are listed, any of them works;
#                             make a dedicated one so it can be rotated on its own.
#
# The service role key bypasses RLS, so it is server-only: never give it a
# NEXT_PUBLIC_ prefix and never reference it from a client component.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Auth (single user) ----------
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET="change-me-to-a-long-random-string"
# The password you log in with
APP_PASSWORD="change-me"

# ---------- Google Places API (New) ----------
# Enable "Places API (New)" in Google Cloud and restrict the key
GOOGLE_PLACES_API_KEY=""

# ---------- Anthropic (AI analysis + message drafting) ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
